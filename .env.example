# Host address and port exposed by Docker.
# Keep 127.0.0.1 when a reverse proxy runs on the same host.
ENDERVAULT_BIND_ADDRESS=127.0.0.1
ENDERVAULT_HTTP_PORT=8080

# Host directories mounted into the container.
ENDERVAULT_STATE_DIR=./docker/runtime/state
ENDERVAULT_STORAGE_PATH=./docker/runtime/storage

# Numeric host account that can read/write both mounted directories.
# On Linux, use the output of: id -u  and  id -g
ENDERVAULT_UID=1000
ENDERVAULT_GID=1000

TZ=Asia/Seoul

# Optional Gluetun custom OpenVPN profile.
# Place exactly one selected profile and any referenced certificate files here.
ENDERVAULT_VPN_STATE_DIR=./docker/runtime/vpn
ENDERVAULT_VPN_CONFIG_DIR=./docker/secrets/vpn/config
ENDERVAULT_VPN_CONFIG_NAME=custom.ovpn

# Optional OpenVPN credentials. Keep the real .env file out of Git and backups
# that are not intended to contain secrets.
ENDERVAULT_OPENVPN_USER=
ENDERVAULT_OPENVPN_PASSWORD=
