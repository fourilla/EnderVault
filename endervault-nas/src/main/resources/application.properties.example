# Copy the keys you need into ./endervault-nas.properties next to the jar,
# or into ${user.home}/.endervault-nas/application.properties.
# Those external files are for machine-specific paths and secrets.

spring.servlet.multipart.max-file-size=20GB
spring.servlet.multipart.max-request-size=20GB

# Development example: ./storage
# Linux server example: /mnt/external_drive
nas.storage.root=/mnt/external_drive
nas.storage.trash-directory=.trash
nas.storage.metadata-directory=.endervault

nas.trash.retention-days=30
nas.trash.cleanup-on-startup=true
nas.trash.cleanup-interval-ms=3600000

nas.thumbnails.video-enabled=true
nas.thumbnails.comic-enabled=true
nas.thumbnails.cache-directory=thumbnails
nas.thumbnails.generator-threads=1

nas.browser.default-view=table
nas.browser.default-sort=name
nas.browser.default-direction=asc
nas.browser.default-page-size=200

nas.file-tools.text-auto-load-max-bytes=1048576
nas.file-tools.text-manual-load-max-bytes=20971520
nas.file-tools.comic-max-pages=5000
nas.file-tools.comic-page-max-bytes=104857600
nas.file-tools.comic-info-max-bytes=65536

nas.admin.username=admin
nas.admin.password={noop}change-me

nas.notifications.telegram.enabled=false
nas.notifications.telegram.bot-token=
nas.notifications.telegram.chat-id=

logging.file.name=logs/endervault-nas.log
logging.level.io.github.fourilla.endervault=INFO
