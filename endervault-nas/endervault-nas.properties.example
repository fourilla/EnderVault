# Copy this file to endervault-nas.properties next to the jar.
# Keep the copied file out of git because it contains local paths and secrets.

spring.servlet.multipart.max-file-size=20GB
spring.servlet.multipart.max-request-size=20GB

# Development example: ./storage
# Linux server example: /mnt/external_drive
nas.storage.root=/mnt/external_drive
nas.storage.trash-directory=.trash
nas.storage.metadata-directory=.endervault

nas.thumbnails.video-enabled=true
nas.thumbnails.cache-directory=thumbnails
nas.thumbnails.generator-threads=1

nas.admin.username=admin
nas.admin.password={noop}change-me

nas.notifications.telegram.enabled=false
nas.notifications.telegram.bot-token=
nas.notifications.telegram.chat-id=

logging.file.name=logs/endervault-nas.log
logging.level.io.github.fourilla.endervault=INFO
